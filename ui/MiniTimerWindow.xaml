<Window
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="番茄洞察计时"
        Width="90" Height="26"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        ShowActivated="False"
        Focusable="False"
        WindowStartupLocation="Manual"
        FontFamily="Microsoft YaHei UI, Segoe UI"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True">

    <Border Margin="0" CornerRadius="8" Background="#D80E1317" BorderBrush="#3AFFFFFF" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="10" ShadowDepth="1" Opacity="0.35" Color="#000000"/>
        </Border.Effect>
        <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Ellipse x:Name="MiniTimerDot" Width="5" Height="5" Fill="#63E6BE" VerticalAlignment="Center" Margin="0,0,6,0"/>
                <TextBlock x:Name="MiniTimerText" Text="00:00:00" FontFamily="Consolas" FontSize="12" FontWeight="SemiBold" Foreground="#F4F7F8" VerticalAlignment="Center"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
