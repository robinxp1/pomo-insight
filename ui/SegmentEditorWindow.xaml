<Window
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="更改工作段"
        Width="372"
        SizeToContent="Height"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        FontFamily="Microsoft YaHei UI, Segoe UI"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True">

    <Window.Resources>
        <SolidColorBrush x:Key="TextMain" Color="#F4F7F8"/>
        <SolidColorBrush x:Key="TextMuted" Color="#9AA8B2"/>
        <SolidColorBrush x:Key="Accent" Color="#63E6BE"/>
        <SolidColorBrush x:Key="Danger" Color="#FF7A90"/>

        <Style x:Key="EditorTextBox" TargetType="TextBox">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource TextMain}"/>
            <Setter Property="CaretBrush" Value="{StaticResource Accent}"/>
            <Setter Property="SelectionBrush" Value="{StaticResource Accent}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style x:Key="EditorPrimaryButton" TargetType="Button">
            <Setter Property="Height" Value="36"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="Background" Value="{StaticResource Accent}"/>
            <Setter Property="Foreground" Value="#0A1215"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="11" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.9"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.72"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="EditorGhostButton" TargetType="Button">
            <Setter Property="Height" Value="36"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="Background" Value="#12FFFFFF"/>
            <Setter Property="Foreground" Value="{StaticResource TextMain}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="11" Padding="{TemplateBinding Padding}" BorderBrush="#20FFFFFF" BorderThickness="1">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#1EFFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.72"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="EditorIconButton" TargetType="Button">
            <Setter Property="Width" Value="28"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource TextMuted}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#14FFFFFF"/>
                                <Setter Property="Foreground" Value="{StaticResource TextMain}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Background="#151C21" BorderBrush="#2AFFFFFF" BorderThickness="1" CornerRadius="16" Padding="20">
        <StackPanel>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock x:Name="EditorTitleText" Text="更改工作段" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource TextMain}" Cursor="SizeAll"/>
                    <TextBlock x:Name="EditorHintText" Text="调整开始或结束时间，保存后会重新计算工作时长。" FontSize="10" Foreground="{StaticResource TextMuted}" TextWrapping="Wrap" Margin="0,4,10,0"/>
                </StackPanel>
                <Button x:Name="CloseButton" Grid.Column="1" Style="{StaticResource EditorIconButton}" Content="✕" ToolTip="关闭" VerticalAlignment="Top"/>
            </Grid>

            <TextBlock Text="工作内容" FontSize="10" Foreground="{StaticResource TextMuted}" Margin="0,18,0,0"/>
            <Border Background="#0DFFFFFF" BorderBrush="#2AFFFFFF" BorderThickness="1" CornerRadius="10" Height="36" Padding="11,0" Margin="0,5,0,0">
                <TextBox x:Name="TaskBox" Style="{StaticResource EditorTextBox}" MaxLength="120"/>
            </Border>

            <Grid Margin="0,12,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="开始时间" FontSize="10" Foreground="{StaticResource TextMuted}"/>
                    <Border Background="#0DFFFFFF" BorderBrush="#2AFFFFFF" BorderThickness="1" CornerRadius="10" Height="36" Padding="11,0" Margin="0,5,0,0">
                        <TextBox x:Name="StartTimeBox" Style="{StaticResource EditorTextBox}" MaxLength="5" HorizontalContentAlignment="Center" FontFamily="Consolas" FontSize="14" FontWeight="SemiBold"/>
                    </Border>
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="结束时间" FontSize="10" Foreground="{StaticResource TextMuted}"/>
                    <Border Background="#0DFFFFFF" BorderBrush="#2AFFFFFF" BorderThickness="1" CornerRadius="10" Height="36" Padding="11,0" Margin="0,5,0,0">
                        <TextBox x:Name="EndTimeBox" Style="{StaticResource EditorTextBox}" MaxLength="5" HorizontalContentAlignment="Center" FontFamily="Consolas" FontSize="14" FontWeight="SemiBold"/>
                    </Border>
                </StackPanel>
            </Grid>

            <TextBlock Text="按今天计算，使用 24 小时制 HH:mm；结束时间不能晚于现在。" FontSize="9.5" Foreground="{StaticResource TextMuted}" TextWrapping="Wrap" Margin="0,8,0,0"/>
            <TextBlock x:Name="EditorErrorText" Text="" FontSize="10" Foreground="{StaticResource Danger}" TextWrapping="Wrap" Margin="0,8,0,0" Visibility="Collapsed"/>

            <Grid Margin="0,18,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Button x:Name="CancelButton" Style="{StaticResource EditorGhostButton}" Content="取消" IsCancel="True"/>
                <Button x:Name="SaveButton" Grid.Column="2" Style="{StaticResource EditorPrimaryButton}" Content="保存" IsDefault="True"/>
            </Grid>
        </StackPanel>
    </Border>
</Window>
