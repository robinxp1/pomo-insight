<Window
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="番茄洞察"
        Width="360" Height="66"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        WindowStartupLocation="Manual"
        FontFamily="Microsoft YaHei UI, Segoe UI"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True">

    <Window.Resources>
        <SolidColorBrush x:Key="TextMain" Color="#F4F7F8"/>
        <SolidColorBrush x:Key="TextMuted" Color="#9AA8B2"/>
        <SolidColorBrush x:Key="Accent" Color="#63E6BE"/>
        <SolidColorBrush x:Key="AccentDim" Color="#2A63E6BE"/>
        <SolidColorBrush x:Key="Danger" Color="#FF7A90"/>
        <SolidColorBrush x:Key="Warn" Color="#FFB86B"/>

        <Style x:Key="RoundActionButton" TargetType="Button">
            <Setter Property="Width" Value="38"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="Background" Value="{StaticResource Accent}"/>
            <Setter Property="Foreground" Value="#0C1417"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="19" BorderThickness="0">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.9"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.72"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.28"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Height" Value="40"/>
            <Setter Property="Padding" Value="18,0"/>
            <Setter Property="Background" Value="{StaticResource Accent}"/>
            <Setter Property="Foreground" Value="#0A1215"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="12" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.9"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.72"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.35"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="GhostButton" TargetType="Button">
            <Setter Property="Height" Value="38"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="Background" Value="#12FFFFFF"/>
            <Setter Property="Foreground" Value="{StaticResource TextMain}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="11" Padding="{TemplateBinding Padding}" BorderBrush="#20FFFFFF" BorderThickness="1">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#1EFFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.72"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.32"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ChipButton" TargetType="Button">
            <Setter Property="Height" Value="25"/>
            <Setter Property="Margin" Value="0,0,7,0"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="Background" Value="#10FFFFFF"/>
            <Setter Property="Foreground" Value="#D7E1E7"/>
            <Setter Property="FontSize" Value="10.5"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="9" Padding="{TemplateBinding Padding}" MaxWidth="180">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource AccentDim}"/>
                                <Setter Property="Foreground" Value="{StaticResource Accent}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PresetButton" TargetType="Button">
            <Setter Property="Height" Value="32"/>
            <Setter Property="Margin" Value="0,0,7,7"/>
            <Setter Property="Padding" Value="11,0"/>
            <Setter Property="Background" Value="#10FFFFFF"/>
            <Setter Property="Foreground" Value="#D7E1E7"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="10" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource AccentDim}"/>
                                <Setter Property="Foreground" Value="{StaticResource Accent}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#3063E6BE"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ExportButton" TargetType="Button" BasedOn="{StaticResource GhostButton}">
            <Setter Property="Width" Value="112"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="FontSize" Value="10.5"/>
        </Style>

        <Style x:Key="IconButton" TargetType="Button">
            <Setter Property="Width" Value="30"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource TextMuted}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="9">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#14FFFFFF"/>
                                <Setter Property="Foreground" Value="{StaticResource TextMain}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="HistoryItemButton" TargetType="Button">
            <Setter Property="Height" Value="34"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource TextMain}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="8" Padding="9,0">
                            <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#16FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#22FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextMuted}"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="Margin" Value="0,0,0,5"/>
        </Style>

        <Style x:Key="SettingsField" TargetType="TextBox">
            <Setter Property="Height" Value="34"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource TextMain}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="CaretBrush" Value="{StaticResource Accent}"/>
            <Setter Property="SelectionBrush" Value="{StaticResource AccentDim}"/>
            <Setter Property="Padding" Value="10,0"/>
        </Style>

        <Style x:Key="SlimScrollBar" TargetType="ScrollBar">
            <Setter Property="Width" Value="3"/>
            <Setter Property="MinWidth" Value="3"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Background="Transparent">
                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="{x:Static ScrollBar.PageUpCommand}" Focusable="False" Opacity="0"/>
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb x:Name="ScrollThumb" Width="3" MinWidth="3" Background="#33FFFFFF">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border Background="{TemplateBinding Background}" CornerRadius="1.5"/>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="{x:Static ScrollBar.PageDownCommand}" Focusable="False" Opacity="0"/>
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ScrollThumb" Property="Background" Value="#66FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border x:Name="WindowShell" Margin="6" CornerRadius="18" Background="#CC181C23" BorderBrush="#33FFFFFF" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="18" ShadowDepth="2" Opacity="0.35" Color="#000000"/>
        </Border.Effect>
        <Grid>
            <Grid x:Name="CompactView" Margin="6" VerticalAlignment="Center">
                <Grid x:Name="CompactIdlePanel">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Background="#18FFFFFF" BorderBrush="#32FFFFFF" BorderThickness="1" CornerRadius="12" Height="40">
                        <Grid>
                            <TextBox x:Name="TaskTextBox" MaxLength="80" Background="Transparent" BorderThickness="0" Foreground="{StaticResource TextMain}" FontSize="12.5" VerticalContentAlignment="Center" Padding="11,0,10,0" CaretBrush="{StaticResource Accent}" SelectionBrush="{StaticResource AccentDim}"/>
                            <TextBlock x:Name="TaskPlaceholder" Text="输入工作内容，回车开始" FontSize="12" Foreground="#84939E" VerticalAlignment="Center" Margin="12,0,0,0" IsHitTestVisible="False"/>
                        </Grid>
                    </Border>
                    <Button x:Name="StartButton" Grid.Column="1" Style="{StaticResource RoundActionButton}" Margin="8,0,0,0" ToolTip="开始记录">
                        <Path x:Name="PlayIcon" Data="M 7,4 L 7,20 L 20,12 Z" Fill="#0C1417" Stretch="Uniform" Width="15" Height="15" Margin="2,0,0,0" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Button>
                    <Button x:Name="ExpandButton" Grid.Column="2" Style="{StaticResource IconButton}" ToolTip="查看今日数据" Width="28" Height="28" Margin="5,0,0,0" VerticalAlignment="Center">
                        <Path x:Name="ExpandChevron" Data="M 4,6 L 9,11 L 4,16" Stroke="{StaticResource TextMuted}" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="9" Height="12" Stretch="Uniform"/>
                    </Button>
                </Grid>

                <Grid x:Name="CompactActivePanel" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="CompactTaskText" Text="开发工作" FontSize="12.5" FontWeight="SemiBold" Foreground="{StaticResource TextMain}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                        <TextBlock x:Name="CompactStartedText" Grid.Column="1" Text="11:00 开始" FontSize="9.5" Foreground="{StaticResource TextMuted}" Margin="8,1,0,0" VerticalAlignment="Center"/>
                        <Button x:Name="CompactExpandButton" Grid.Column="2" Style="{StaticResource IconButton}" ToolTip="查看今日数据" Width="28" Height="28" Margin="4,0,0,0">
                            <Path Data="M 4,6 L 9,11 L 4,16" Stroke="{StaticResource TextMuted}" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="9" Height="12" Stretch="Uniform"/>
                        </Button>
                    </Grid>
                    <Grid Grid.Row="1" Margin="0,1,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="CompactTimerText" Text="00:00:00" FontFamily="Consolas" FontSize="26" FontWeight="SemiBold" Foreground="{StaticResource TextMain}"/>
                        <TextBlock x:Name="CompactModeText" Grid.Column="1" Text="" FontSize="9.5" Foreground="{StaticResource TextMuted}" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="8,0,1,3"/>
                    </Grid>
                    <Grid Grid.Row="2" Margin="0,4,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Button x:Name="TakeBreakButton" Style="{StaticResource GhostButton}" Height="30" FontSize="11" Content="现在休息" HorizontalAlignment="Left" Padding="12,0"/>
                        <Button x:Name="StopButton" Grid.Column="1" Style="{StaticResource GhostButton}" Height="30" FontSize="11" Content="结束并保存" MinWidth="84" Foreground="{StaticResource Danger}" Padding="11,0"/>
                    </Grid>
                </Grid>
            </Grid>

            <Grid x:Name="ExpandedView" Margin="16,12,16,14" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Ellipse x:Name="HeaderDot" Width="7" Height="7" Fill="{StaticResource Accent}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock x:Name="HeaderStatusText" Text="TODAY" FontSize="10" FontWeight="Bold" Foreground="{StaticResource Accent}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button x:Name="SettingsButton" Style="{StaticResource IconButton}" ToolTip="设置">
                            <TextBlock Text="⚙" FontSize="15" Foreground="{StaticResource TextMuted}"/>
                        </Button>
                        <Button x:Name="CollapseButton" Style="{StaticResource IconButton}" ToolTip="收起" Margin="2,0,0,0">
                            <Path Data="M 10,4 L 5,9 L 10,14" Stroke="{StaticResource TextMuted}" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="9" Height="12" Stretch="Uniform"/>
                        </Button>
                    </StackPanel>
                </Grid>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,1,0" Margin="0,8,0,0">
                    <ScrollViewer.Resources>
                        <Style TargetType="ScrollBar" BasedOn="{StaticResource SlimScrollBar}"/>
                    </ScrollViewer.Resources>
                    <StackPanel>
                        <StackPanel x:Name="NormalContent">
                            <TextBlock Text="今天" FontSize="22" FontWeight="SemiBold" Foreground="{StaticResource TextMain}"/>
                            <TextBlock x:Name="TodayDateText" Text="" FontSize="11" Foreground="{StaticResource TextMuted}" Margin="0,4,0,0"/>

                            <Border Background="#12FFFFFF" BorderBrush="#1FFFFFFF" BorderThickness="1" CornerRadius="14" Padding="14" Margin="0,13,0,0">
                                <UniformGrid Columns="4">
                                    <StackPanel>
                                        <TextBlock x:Name="TodayWorkText" Text="0m" FontFamily="Consolas" FontSize="17" FontWeight="SemiBold" Foreground="{StaticResource TextMain}"/>
                                        <TextBlock Text="实际工作" FontSize="9" Foreground="{StaticResource TextMuted}" Margin="0,2,0,0"/>
                                    </StackPanel>
                                    <StackPanel>
                                        <TextBlock x:Name="TodayBreakText" Text="0m" FontFamily="Consolas" FontSize="17" FontWeight="SemiBold" Foreground="{StaticResource TextMain}"/>
                                        <TextBlock Text="非工作" FontSize="9" Foreground="{StaticResource TextMuted}" Margin="0,2,0,0"/>
                                    </StackPanel>
                                    <StackPanel>
                                        <TextBlock x:Name="TodaySessionsText" Text="0" FontFamily="Consolas" FontSize="17" FontWeight="SemiBold" Foreground="{StaticResource TextMain}"/>
                                        <TextBlock Text="工作段" FontSize="9" Foreground="{StaticResource TextMuted}" Margin="0,2,0,0"/>
                                    </StackPanel>
                                    <StackPanel>
                                        <TextBlock x:Name="TodayLongestText" Text="0m" FontFamily="Consolas" FontSize="17" FontWeight="SemiBold" Foreground="{StaticResource TextMain}"/>
                                        <TextBlock Text="最长专注" FontSize="9" Foreground="{StaticResource TextMuted}" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </UniformGrid>
                            </Border>

                            <Border x:Name="ExpandedActivePanel" Background="#10FFFFFF" BorderBrush="#24FFFFFF" BorderThickness="1" CornerRadius="14" Padding="14" Margin="0,12,0,0" Visibility="Collapsed">
                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock x:Name="ExpandedModeText" Text="正在专注" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource Accent}"/>
                                        <TextBlock x:Name="ExpandedStartedText" Grid.Column="1" Text="" FontSize="10" Foreground="{StaticResource TextMuted}"/>
                                    </Grid>
                                    <TextBlock x:Name="ExpandedTaskText" Text="" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource TextMain}" TextWrapping="Wrap" Margin="0,5,0,0"/>
                                    <TextBlock x:Name="ExpandedTimerText" Text="00:00:00" FontFamily="Consolas" FontSize="30" FontWeight="SemiBold" Foreground="{StaticResource TextMain}" Margin="0,5,0,3"/>
                                    <TextBlock x:Name="ExpandedReminderHintText" Text="" FontSize="10" Foreground="{StaticResource TextMuted}" TextWrapping="Wrap"/>
                                    <Grid Margin="0,10,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Button x:Name="ExpandedTakeBreakButton" Style="{StaticResource PrimaryButton}" Content="现在休息" HorizontalAlignment="Stretch" Margin="0,0,8,0"/>
                                        <Button x:Name="ExpandedStopButton" Grid.Column="1" Style="{StaticResource GhostButton}" Content="结束并保存" MinWidth="104"/>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <Grid Margin="0,16,0,7">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="今日工作段" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource TextMuted}" VerticalAlignment="Center"/>
                                <Button x:Name="BackfillButton" Grid.Column="1" Style="{StaticResource ChipButton}" Content="＋ 补录" Height="24" Padding="9,0" Margin="0" ToolTip="补录一段今天忘记记录的工作时间"/>
                            </Grid>
                            <StackPanel x:Name="RecentSessionsPanel"/>
                            <TextBlock x:Name="EmptySessionsText" Text="今天还没有工作记录。在上方输入工作内容后开始。" FontSize="11" Foreground="{StaticResource TextMuted}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                        </StackPanel>

                        <StackPanel x:Name="SettingsPanel" Visibility="Collapsed">
                            <TextBlock Text="提醒节律" FontSize="22" FontWeight="SemiBold" Foreground="{StaticResource TextMain}"/>
                            <TextBlock x:Name="PresetDescriptionText" Text="平衡模式：50 分钟专注 + 10 分钟休息。适合需要连续推进的开发、写作和深度阅读，在专注深度与休息频率之间取平衡。" FontSize="11" Foreground="{StaticResource TextMuted}" Margin="0,5,0,12" TextWrapping="Wrap" LineHeight="17"/>
                            <TextBlock Text="快捷模式" Style="{StaticResource FieldLabel}" Margin="0,0,0,6"/>
                            <WrapPanel Margin="0,0,0,3">
                                <Button x:Name="PresetPomodoroButton" Style="{StaticResource PresetButton}" Content="番茄 25/5"/>
                                <Button x:Name="PresetBalancedButton" Style="{StaticResource PresetButton}" Content="平衡 50/10"/>
                                <Button x:Name="PresetObserveButton" Style="{StaticResource PresetButton}" Content="52/17 观察"/>
                            </WrapPanel>
                            <TextBlock x:Name="PresetStatusText" Text="当前：平衡 50/10" FontSize="9.5" Foreground="{StaticResource Accent}" Margin="0,0,0,10"/>
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,0,10">
                                    <TextBlock Text="专注提醒（分钟）" Style="{StaticResource FieldLabel}"/>
                                    <Border Background="#0DFFFFFF" BorderBrush="#2AFFFFFF" BorderThickness="1" CornerRadius="10">
                                        <TextBox x:Name="FocusMinutesBox" Style="{StaticResource SettingsField}"/>
                                    </Border>
                                </StackPanel>
                                <StackPanel Grid.Row="0" Grid.Column="2" Margin="0,0,0,10">
                                    <TextBlock Text="建议休息（分钟）" Style="{StaticResource FieldLabel}"/>
                                    <Border Background="#0DFFFFFF" BorderBrush="#2AFFFFFF" BorderThickness="1" CornerRadius="10">
                                        <TextBox x:Name="BreakMinutesBox" Style="{StaticResource SettingsField}"/>
                                    </Border>
                                </StackPanel>
                                <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,0,10">
                                    <TextBlock Text="延后一次（分钟）" Style="{StaticResource FieldLabel}"/>
                                    <Border Background="#0DFFFFFF" BorderBrush="#2AFFFFFF" BorderThickness="1" CornerRadius="10">
                                        <TextBox x:Name="SnoozeMinutesBox" Style="{StaticResource SettingsField}"/>
                                    </Border>
                                </StackPanel>
                                <StackPanel Grid.Row="1" Grid.Column="2" Margin="0,0,0,10">
                                    <TextBlock Text="最长连续专注（分钟）" Style="{StaticResource FieldLabel}"/>
                                    <Border Background="#0DFFFFFF" BorderBrush="#2AFFFFFF" BorderThickness="1" CornerRadius="10">
                                        <TextBox x:Name="MaxFocusMinutesBox" Style="{StaticResource SettingsField}"/>
                                    </Border>
                                </StackPanel>
                            </Grid>
                            <CheckBox x:Name="AutoStartCheckBox" Foreground="{StaticResource TextMain}" FontSize="12" Margin="0,7,0,0" Content="开机自动启动（不需要管理员权限）"/>
                            <CheckBox x:Name="EyeReminderCheckBox" Foreground="{StaticResource TextMain}" FontSize="12" Margin="0,10,0,0" Content="20 分钟护眼轻提醒（默认关闭，避免打断心流）"/>
                            <CheckBox x:Name="AlwaysOnTopCheckBox" Foreground="{StaticResource TextMain}" FontSize="12" Margin="0,10,0,0" Content="浮窗保持在最前面"/>
                            <Border Background="#0AFFFFFF" BorderBrush="#1FFFFFFF" BorderThickness="1" CornerRadius="12" Padding="12" Margin="0,14,0,0">
                                <StackPanel>
                                    <TextBlock Text="数据存储位置" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource TextMuted}"/>
                                    <TextBlock x:Name="DataLocationText" Text="" FontSize="9.5" Foreground="{StaticResource TextMain}" TextWrapping="Wrap" Margin="0,5,0,0"/>
                                    <TextBlock Text="更改位置时会复制现有记录，之后的新记录写入新目录。" FontSize="9" Foreground="{StaticResource TextMuted}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                    <Button x:Name="ChangeDataLocationButton" Style="{StaticResource GhostButton}" Content="更改存储位置" HorizontalAlignment="Left" Height="30" FontSize="11" Padding="12,0" Margin="0,8,0,0"/>
                                </StackPanel>
                            </Border>
                            <Grid Margin="0,17,0,0">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <Button x:Name="SaveSettingsButton" Style="{StaticResource PrimaryButton}" Content="保存设置"/>
                                <Button x:Name="CancelSettingsButton" Grid.Column="2" Style="{StaticResource GhostButton}" Content="返回"/>
                            </Grid>
                            <Grid Margin="0,16,0,0">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <Button x:Name="OpenDataFolderButton" Style="{StaticResource GhostButton}" Content="数据目录" Margin="0,0,4,0"/>
                                <Button x:Name="ExitAppButton" Grid.Column="1" Style="{StaticResource GhostButton}" Content="退出番茄洞察" Foreground="{StaticResource Danger}" Margin="4,0,0,0"/>
                            </Grid>
                            <TextBlock Text="本地运行 · 不联网 · 不写 Excel · 不需要管理员权限" FontSize="9.5" Foreground="#66747E" HorizontalAlignment="Center" Margin="0,13,0,0"/>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>

                <Grid x:Name="ExportBar" Grid.Row="2" Margin="0,12,0,0">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button x:Name="ExportJsonButton" Style="{StaticResource ExportButton}" Content="导出JSON"/>
                        <Button x:Name="ExportCsvButton" Style="{StaticResource ExportButton}" Content="导出CSV" Margin="5,0,0,0"/>
                        <Button x:Name="ExportBriefButton" Style="{StaticResource ExportButton}" Content="导出AI解读提示词" Margin="5,0,0,0" ToolTip="导出给 AI 的分析提示词"/>
                    </StackPanel>
                </Grid>
            </Grid>

            <Popup x:Name="RecentTasksPopup"
                   Placement="Bottom"
                   PlacementTarget="{Binding ElementName=TaskTextBox}"
                   VerticalOffset="5"
                   StaysOpen="True"
                   AllowsTransparency="True"
                   PopupAnimation="None"
                   Focusable="False">
                <Border x:Name="RecentTasksPopupShell" Width="252" Background="#F21A1F26" BorderBrush="#38FFFFFF" BorderThickness="1" CornerRadius="12" Padding="5">
                    <StackPanel x:Name="RecentTasksPanel"/>
                </Border>
            </Popup>

            <Border x:Name="EdgePeek" Width="4" Margin="4,22,0,22" HorizontalAlignment="Left" VerticalAlignment="Stretch" CornerRadius="2" Background="{StaticResource Accent}" Visibility="Collapsed" IsHitTestVisible="False"/>
        </Grid>
    </Border>
</Window>
